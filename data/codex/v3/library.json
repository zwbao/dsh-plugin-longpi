 "chapters": [
  {
   "id": "clock",
   "no": 1,
   "title_zh": "身体的钟",
   "motif": "clock",
   "intro_zh": "生物年龄有很多种算法：血液化验、DNA 甲基化、手环脉搏。这一章讲它们怎么算、稳不稳、能说明什么。",
   "size": 0
  },
  {
   "id": "organ",
   "no": 2,
   "title_zh": "器官与代谢",
   "motif": "organ",
   "intro_zh": "同一个人的不同器官可能老得不一样快。研究者从血浆蛋白、代谢物、影像和常规化验里估每个器官的状态。",
   "size": 0
  },
  {
   "id": "brain",
   "no": 3,
   "title_zh": "大脑与心理",
   "motif": "brain",
   "intro_zh": "大脑衰老和痴呆风险是论文最多的方向之一：从血液标志物、脑影像，一直到单个神经元，也包括孤独感这样的心理因素。",
   "size": 0
  },
  {
   "id": "immune",
   "no": 4,
   "title_zh": "免疫与炎症",
   "motif": "immune",
   "intro_zh": "年纪越大，免疫系统越容易处在低度炎症里，研究者叫它「炎性衰老」。衰老细胞也在这里登场。",
   "size": 0
  },
  {
   "id": "repair",
   "no": 5,
   "title_zh": "细胞的维修",
   "motif": "repair",
   "intro_zh": "细胞靠自噬清理垃圾、靠线粒体供能、靠营养感应决定什么时候修补。很多抗衰老药物的靶点都在这里。",
   "size": 0
  },
  {
   "id": "tissue",
   "no": 6,
   "title_zh": "组织与再生",
   "motif": "tissue",
   "intro_zh": "皮肤、肌肉和软骨怎么变老，有的动物又为什么能长回来。",
   "size": 0
  },
  {
   "id": "gene",
   "no": 7,
   "title_zh": "生殖与基因",
   "motif": "gene",
   "intro_zh": "卵巢是最早衰老的器官之一；百岁老人的基因里藏着线索，药物代谢和饮酒反应也写在基因里。",
   "size": 0
  },
  {
   "id": "span",
   "no": 8,
   "title_zh": "寿命与节律",
   "motif": "span",
   "intro_zh": "寿命怎么量、衰弱从哪来、生物钟乱了会怎样，以及别的物种为什么活得更久。",
   "size": 0
  }
 ],
