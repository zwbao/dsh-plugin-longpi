{
  "name": "dsh-plugin-longpi",
  "version": "4.1.0",
  "description": "Personal longevity harness for DeepSeek Harness: dispatch longevity-skills by intent from one person's Mirobody record, convert and check measurement units before a skill runs, look up collected evidence, and show a health board.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "skills",
    "docs",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf lib",
    "smoke": "node test/smoke.mjs",
    "test": "npm run build && node test/smoke.mjs && node test/units.mjs && node test/guard.mjs && node test/v2.mjs && node test/dispatch.mjs && node test/mirobody-format.mjs && node test/interventions.mjs",
    "eval:dispatch": "node test/dispatch.mjs --verbose",
    "preview": "npm run build && node preview/build.mjs && echo 'serve with: python3 -m http.server 4173 -d preview/out'"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "longevity",
    "health",
    "mirobody"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0 || >=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0",
    "@deepseek-ai/schemastery": ">=3.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  }
}
